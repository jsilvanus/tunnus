# Core
ISSUER=https://id.example.org
DATABASE_URL=postgres://tunnus:tunnus_password@localhost:5432/tunnus
CLIENTS_FILE=./clients.json
KEY_ENCRYPTION_SECRET=change-me
COOKIE_SECRETS=change-me-1,change-me-0
TRUST_PROXY=false

# Sign-up and groups
SIGNUP_EMAIL_DOMAINS=example.org
DEFAULT_GROUPS=all
SESSION_TTL_DAYS=14

# Mail: smtp | brevo | console
MAIL_PROVIDER=console
MAIL_FROM=Tunnus <no-reply@example.org>
SMTP_URL=
BREVO_API_KEY=

# Branding and locale
BRAND_NAME=Example
BRAND_LOGO_URL=
BRAND_COLOR=#1f4e79
DEFAULT_LOCALE=en
PRIVACY_NOTICE_URL=

# Personal data
INACTIVE_USER_DELETE_DAYS=730
INACTIVE_USER_WARN_DAYS=30
AUDIT_RETENTION_DAYS=365
AUDIT_IP_RETENTION_DAYS=30
CONTROLLER_NAME=Example Organisation
CONTROLLER_CONTACT=privacy@example.org
DPO_CONTACT=
# JSON list, or set PROCESSORS_FILE to a path
PROCESSORS=[{"name":"Mail provider","purpose":"Sending sign-in codes","location":"EU"}]

# Metrics
METRICS_BEARER_TOKEN=
