# Core
# HTTP port the server listens on
PORT=3000
ISSUER=https://id.example.org
DATABASE_URL=postgres://tunnus:tunnus_password@localhost:5432/tunnus
CLIENTS_FILE=./clients.json
# Use random values: KEY_ENCRYPTION_SECRET 32+ characters, each COOKIE_SECRETS item 16+.
# The values below are placeholders for illustration only; replace them before use.
KEY_ENCRYPTION_SECRET=EXAMPLE-ONLY-not-a-real-key-secret-0000
COOKIE_SECRETS=EXAMPLE-ONLY-cookie-secret-1,EXAMPLE-ONLY-cookie-secret-0
TRUST_PROXY=false

# Sign-up and groups
# Patterns use * as wildcard; deny wins over allow
SIGNUP_EMAIL_ALLOW=*@example.org
SIGNUP_EMAIL_DENY=ext-*@example.org
DEFAULT_GROUPS=all
SESSION_TTL_DAYS=14
# Days before a TOTP user must re-verify via email code/link (0 disables periodic re-verification)
TOTP_EMAIL_REVERIFY_DAYS=7

# Mail: smtp | brevo | console
MAIL_PROVIDER=console
# console is refused for an https ISSUER because it logs sign-in codes. This example is for
# development: for production set MAIL_PROVIDER=smtp or brevo and remove ALLOW_CONSOLE_MAIL.
ALLOW_CONSOLE_MAIL=true
MAIL_FROM=Tunnus <no-reply@example.org>
SMTP_URL=
BREVO_API_KEY=
# Brevo templates (only read when MAIL_PROVIDER=brevo; plain text is sent when unset).
# Template ids are positive integers. A per-locale id overrides the default for that locale.
# BREVO_TEMPLATE_SIGNIN_ID=12
# BREVO_TEMPLATE_SIGNIN_ID_FI=
# BREVO_TEMPLATE_SIGNIN_ID_SV=
# BREVO_TEMPLATE_SIGNIN_ID_EN=
# BREVO_TEMPLATE_INACTIVE_ID=13
# BREVO_TEMPLATE_INACTIVE_ID_FI=
# BREVO_TEMPLATE_INACTIVE_ID_SV=
# BREVO_TEMPLATE_INACTIVE_ID_EN=
# Mail relay: POST <issuer>/api/mail is off while this is empty
MAIL_RELAY_TOKEN=

# Log level: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info

# Rate limits. Per address per hour and per IP per hour (codes issued). An address is locked
# for an hour once its failed code attempts reach 10, across all its sign-in pages.
# MAIL_DAILY_CAP counts codes sent per day. Sign-up codes stop at the cap; login codes for
# existing users continue to 1.5 times the cap, so sign-ups alone cannot lock them out.
RATE_LIMIT_EMAIL_PER_HOUR=5
RATE_LIMIT_IP_PER_HOUR=20
MAIL_DAILY_CAP=500

# Branding and locale
BRAND_NAME=Example
BRAND_LOGO_URL=
BRAND_COLOR=#1f4e79
DEFAULT_LOCALE=en
PRIVACY_NOTICE_URL=

# Personal data
INACTIVE_USER_DELETE_DAYS=730
INACTIVE_USER_WARN_DAYS=30
AUDIT_RETENTION_DAYS=365
AUDIT_IP_RETENTION_DAYS=30
CONTROLLER_NAME=Example Organisation
CONTROLLER_CONTACT=privacy@example.org
DPO_CONTACT=
# JSON list of {"name","purpose","location"} shown in the privacy notice.
# Set either PROCESSORS or PROCESSORS_FILE, not both.
PROCESSORS=[{"name":"Mail provider","purpose":"Sending sign-in codes","location":"EU"}]
# Path to a JSON file with the same list (use instead of PROCESSORS)
PROCESSORS_FILE=

# Cleanup job: expired codes, old audit rows, inactive-user warnings and deletion
# Set to true to run it outside the process (tunnus-admin cleanup, from cron)
CLEANUP_DISABLED=false
# Seconds after start before the first run (a random jitter of up to 60 s is added)
CLEANUP_START_DELAY_SECONDS=60
# Hours between runs; must be at least 1
CLEANUP_INTERVAL_HOURS=24

# Metrics: /metrics is off while this is empty
METRICS_BEARER_TOKEN=

# Admin API (<issuer>/admin/api/v1)
# Days a retired signing key stays in JWKS
KEY_RETIRED_GRACE_DAYS=7
# Seconds between checks for key changes made elsewhere; 0 disables
KEY_RELOAD_INTERVAL_SECONDS=60
# Validate admin API responses against openapi.yaml (500 on mismatch)
ADMIN_VALIDATE_RESPONSES=false

# MCP server & OAuth (for ChatGPT / remote MCP clients)
# Mount /mcp and RFC 9728 protected-resource metadata directly on Tunnus
MCP_ENABLED=false
# Enable CIMD + resource indicators in OIDC without mounting /mcp (for standalone tunnus-mcp --http)
MCP_OAUTH_ENABLED=false
# Canonical MCP resource URL (defaults to <ISSUER>/mcp)
MCP_RESOURCE_URL=
