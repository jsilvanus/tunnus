{
  "name": "tunnus",
  "version": "0.12.1",
  "description": "Small self-hosted OpenID Connect provider with passwordless email sign-in",
  "type": "module",
  "private": true,
  "bin": {
    "tunnus": "bin/tunnus.js",
    "tunnus-mcp": "bin/tunnus-mcp.js",
    "tunnus-admin": "bin/tunnus-admin.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "vitest run --exclude '**/*.integration.test.js'",
    "test:integration": "vitest run integration",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/oidc-provider": "^9.13.1",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "openid-client": "^6.8.9",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.3.0",
    "nodemailer": "^10.3.1",
    "oidc-provider": "^9.13.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "web-push": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "license": "EUPL-1.2"
}
