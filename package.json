{
  "name": "tunnus",
  "version": "0.1.0",
  "description": "Small self-hosted OpenID Connect provider with passwordless email sign-in",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "vitest run --exclude '**/*.integration.test.js'",
    "test:integration": "vitest run integration",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/oidc-provider": "^9.13.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "openid-client": "^6.8.9",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "express": "^5.3.0",
    "oidc-provider": "^9.13.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "license": "EUPL-1.2"
}
